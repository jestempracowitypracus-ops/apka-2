rules_version = '2';

// Zdjęcia i głosówki zleceń: dostęp ma dyspozytor i kierowca przydzielony do zlecenia.
service firebase.storage {
  match /b/{bucket}/o {
    match /orders/{orderId}/{allPaths=**} {
      function user() {
        return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      }
      function canAccess() {
        return request.auth != null
          && user().active == true
          && (user().role == 'dispatcher'
              || firestore.get(/databases/(default)/documents/orders/$(orderId)).data.driverId == request.auth.uid);
      }

      allow read: if canAccess();
      allow create: if canAccess()
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));
      allow update, delete: if false;
    }
  }
}
